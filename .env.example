# ─────────────────────────────────────────────────────────────────────
#  Guía UCM — plantilla de variables de entorno
#
#  Copia este archivo a `.env` y rellena los valores reales.
#  `.env` está en .gitignore: NUNCA se sube al repositorio.
#
#      cp .env.example .env
# ─────────────────────────────────────────────────────────────────────

# ── Base de datos (MySQL 8.4 ya desplegado) ──────────────────────────
# En el compose de producción el host es el del contenedor MySQL de tu
# stack existente. En local, `docker-compose.dev.yml` levanta uno
# efímero en el puerto 3307.
DB_URL=jdbc:mysql://localhost:3307/guia_ucm?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USER=guia_ucm
DB_PASS=cambia_esta_password

# ── Firma de JWT ─────────────────────────────────────────────────────
# Mínimo 64 caracteres aleatorios. Genera uno con:
#     openssl rand -base64 64
JWT_SECRET=genera_un_secreto_largo_y_aleatorio_de_al_menos_64_caracteres_aqui

# ── TMDB (carátulas, sinopsis, tráilers, dónde verlo) ────────────────
# https://www.themoviedb.org/settings/api — la key JAMÁS llega al
# navegador: solo la usa el backend.
TMDB_API_KEY=tu_api_key_de_tmdb

# ── CORS ─────────────────────────────────────────────────────────────
# Origen exacto del frontend. En local: http://localhost:5173
CORS_ORIGIN=https://ucm.rubenlav.dev

# ── Correo transaccional (Brevo vía SMTP) ────────────────────────────
# Alta y configuración de SPF/DKIM: ver README, sección «Correo».
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=000000000@smtp-brevo.com
SMTP_PASS=xsmtpsib-clave-smtp-de-brevo
EMAIL_FROM=no-reply@rubenlav.dev

# ── Perfil de Spring ─────────────────────────────────────────────────
# `dev` en local (Swagger y Actuator abiertos, correo a consola),
# `prod` en el servidor.
SPRING_PROFILES_ACTIVE=prod
