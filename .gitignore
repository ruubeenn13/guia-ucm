# ── Secretos y entorno ───────────────────────────────────────────────
# Nunca se sube ningún .env real. Solo .env.example, que va con
# valores de mentira.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
secrets/

# ── Java / Maven ─────────────────────────────────────────────────────
target/
!.mvn/wrapper/maven-wrapper.properties
.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
!**/gradle/wrapper/*.jar
hs_err_pid*
replay_pid*

# ── Node / frontend ──────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
build/
.vite/
coverage/
*.local
.eslintcache
.stylelintcache

# Playwright
/frontend/test-results/
/frontend/playwright-report/
/frontend/blob-report/
/frontend/.playwright/

# ── Datos y volcados ─────────────────────────────────────────────────
# Nada de datos reales en el repo público.
*.sql.gz
*.dump
dumps/
data/
mysql-data/

# ── Editores y sistema operativo ─────────────────────────────────────
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
